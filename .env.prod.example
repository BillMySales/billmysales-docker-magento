# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=magento

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the store (base URLs follow it on every `up`).
MAGE_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Credentials and admin (REQUIRED)
# ---------------------------------------------------------------------------
# Use long random values: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
# MAGE_ADMIN_USER, _PASSWORD and _EMAIL are only used by the installer:
# changing them later in .env doesn't change the account (do it in the admin).
# Magento requires letters and numbers, 7+ characters.
MAGE_ADMIN_PASSWORD=
MAGE_ADMIN_EMAIL=
# Admin URL path (letters, digits and underscores): keep it hard to guess,
# e.g. admin_$(openssl rand -hex 4)
MAGE_ADMIN_PATH=
#MAGE_ADMIN_USER=admin
#DB_NAME=magento
#DB_USER=magento

# ---------------------------------------------------------------------------
# Store (used by the installer / initial settings, only on the first install)
# ---------------------------------------------------------------------------
#MAGE_STORE_NAME=Mage-OS
#MAGE_LOCALE=en_US
#MAGE_CURRENCY=CLP
#MAGE_COUNTRY=CL
# The store's time zone (first install only) and PHP's date.timezone
# (applied on every start).
#PHP_TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Versions and image
# ---------------------------------------------------------------------------
# Mage-OS version: changing it and running `docker compose up -d --build`
# upgrades Mage-OS (new image, code synced and database upgraded by `setup`).
# Back up first.
#MAGEOS_VERSION=3.5.0
#PHP_VERSION=8.5
# Image name for the built Mage-OS image.
#MAGEOS_IMAGE=mageos-fpm
# Modules to disable in the image, space separated (the development template
# disables Magento_TwoFactorAuth; keep 2FA on in production).
#MAGEOS_DISABLE_MODULES=
# Static content built into the image: locales and themes, space separated.
# Every locale/theme used by a store or admin user must be listed here.
#MAGEOS_LOCALES=en_US
# Mage-OS's admin theme is MageOS/m137-admin-theme (child of Magento/backend).
#MAGEOS_THEMES=Magento/luma Magento/backend MageOS/m137-admin-theme
#OPENSEARCH_VERSION=3.8.0
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#MAILPIT_VERSION=v1.31
# Mailpit web UI port (development only, profile "mailpit").
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# PHP and OpenSearch
# ---------------------------------------------------------------------------
# Show PHP errors in the browser: Off in production (errors go to the logs).
#PHP_DISPLAY_ERRORS=Off
# Magento mode: production (compiled in the image). developer is set by
# overrides/module.yaml for module development; never in production.
#MAGE_MODE=production
# Modules to enable (module:enable + setup:upgrade on the next `up`), space
# separated; overrides/module.yaml sets it from MODULE_NAME.
#MAGE_ENABLE_MODULES=
# OPcache checks file timestamps: 0 (files only change with a new image) or
# 1 (live-edited modules; overrides/module.yaml sets it).
#PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
# PHP-FPM memory per request.
#PHP_MEMORY_LIMIT=756M
# CLI commands (setup, cron, console).
#PHP_CLI_MEMORY_LIMIT=1536M
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# PHP-FPM pool. Rough sizing: max_children = RAM for PHP / ~150 MB per worker.
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500
# OpenSearch Java heap (the container needs about twice this).
#OPENSEARCH_HEAP=512m

# ---------------------------------------------------------------------------
# Mail (SMTP), recommended: without SMTP_HOST no emails are sent (the image
# has no local mail server). When SMTP_HOST is set, these values replace the
# store's mail settings on every `up`.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS) or none (no encryption).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Store email address (General Contact sender).
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Cron and backups
# ---------------------------------------------------------------------------
#CRON_INTERVAL=60
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#OPENSEARCH_MEMORY_LIMIT=1536m
#MAGE_MEMORY_LIMIT=1536m
#CRON_MEMORY_LIMIT=1g
#SETUP_MEMORY_LIMIT=2g
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
