# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8103.
MAGE_URL=http://localhost:8103
SITE_ADDRESS=:80
HTTP_PORT=8103
HTTPS_PORT=8403
MAILPIT_PORT=8025

# Admin: http://localhost:8103/admin_dev (letters, digits and underscores only)
MAGE_ADMIN_PATH=admin_dev

# Development image: without the admin two-factor authentication module.
MAGEOS_IMAGE=mageos-fpm-dev
MAGEOS_DISABLE_MODULES=Magento_TwoFactorAuth

# Show PHP errors in the browser (never in production).
PHP_DISPLAY_ERRORS=On

# Dev-only credentials (Magento requires letters and numbers, 7+ characters).
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root
MAGE_ADMIN_USER=admin
MAGE_ADMIN_PASSWORD=admin12345
MAGE_ADMIN_EMAIL=admin@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/module.yaml
#MODULE_PATH=../billmysales-plugin-magento/Sasco/Billmysales
#MODULE_DIR=Sasco/Billmysales
#MODULE_NAME=Sasco_Billmysales
